{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/brosandbrews",
      "destination": "/pages/brosandbrews.html"
    },
    {
      "source": "/success",
      "destination": "/pages/success.html"
    }
  ],
  "redirects": [
    {
      "source": "/capital",
      "destination": "/brosandbrews",
      "permanent": true
    },
    {
      "source": "/joinus",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partner",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/donor",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/grow",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
